# Supabase 연결 문자열 (Supabase > Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT 시크릿 키 (임의의 긴 문자열로 변경하세요)
JWT_SECRET=change-this-to-a-very-long-random-secret-key

# 포트 (Render에서는 자동 설정됨)
PORT=3000

# Supabase Storage (Settings > API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=meal-photos
